<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TimeTracker.Domain\TimeTracker.Domain.csproj" />
    <ProjectReference Include="..\..\src\TimeTracker.Application\TimeTracker.Application.csproj" />
    <ProjectReference Include="..\..\src\TimeTracker.Infrastructure\TimeTracker.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\TimeTracker.Api\TimeTracker.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Permite localizar la raíz del repositorio sin recorrer carpetas. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryRoot</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
