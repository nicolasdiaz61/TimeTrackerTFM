<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Solo nuget.org: evita que un origen privado de la máquina bloquee o contamine el restore. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
