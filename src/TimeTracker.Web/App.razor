@inject TimeTracker.Web.Auth.SessionSynchronizer SessionSync

<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <PasswordChangeGate>
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized Context="authState">
                    @if (authState.User.Identity?.IsAuthenticated == true)
                    {
                        <p role="alert">No tiene permiso para ver esta página.</p>
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
                <Authorizing>
                    <p><em>Comprobando la sesión...</em></p>
                </Authorizing>
            </AuthorizeRouteView>
        </PasswordChangeGate>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>

@code {
    // Sesión compartida entre pestañas (ADR 0028): escucha los cambios que otra pestaña hace en el almacenamiento.
    protected override Task OnInitializedAsync() => SessionSync.StartAsync();
}
