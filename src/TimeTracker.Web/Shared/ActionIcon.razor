@using TimeTracker.Web.Formatting

@* Iconos en línea (sin fuentes ni imágenes externas, compatibles con la CSP). Decorativos: el botón ya tiene texto. *@
<svg class="action-icon" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false">
    @switch (Action)
    {
        case ClockAction.ClockIn:
        case ClockAction.EndBreak:
            <path d="M8 5v14l11-7z" />
            break;
        case ClockAction.StartBreak:
            <path d="M6 5h4v14H6zM14 5h4v14h-4z" />
            break;
        case ClockAction.StartMealBreak:
            <path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z" />
            break;
        default:
            <path d="M6 6h12v12H6z" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public ClockAction Action { get; set; }
}
