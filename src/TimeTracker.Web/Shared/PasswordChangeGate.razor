@inject NavigationManager Navigation

@* Con el cambio de contraseña pendiente (claim mcp) cualquier ruta distinta de /cambiar-contrasena y /login lleva a la página de
   cambio SIN renderizar la ruta pedida, de modo que no se llama a la API (que respondería 403). La API lo impone aparte. *@
@if (!resolved || redirecting)
{
    <p><em>Comprobando la sesión...</em></p>
}
else
{
    @ChildContent
}

@code {
    private bool resolved;
    private bool redirecting;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var state = AuthenticationStateTask is null ? null : await AuthenticationStateTask;
        var target = state is null ? null : PasswordChangeRedirect.TargetFor(state.User, "/" + Navigation.ToBaseRelativePath(Navigation.Uri));
        redirecting = target is not null;
        resolved = true;
        if (target is not null)
        {
            Navigation.NavigateTo(target, replace: true);
        }
    }
}
