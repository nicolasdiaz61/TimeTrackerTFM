@using TimeTracker.Web.Team

@* La contraseña temporal solo vive en la memoria del componente que la muestra y siempre como texto plano (nunca como HTML). *@
@if (Reveal.IsVisible)
{
    <div class="alert alert-warning" role="alert" data-testid="temporary-password-notice">
        <p class="mb-2"><strong>Contraseña temporal de @Reveal.PersonName</strong></p>
        <p class="mb-2"><code class="temporary-password-value" data-testid="temporary-password-value">@Reveal.Value</code></p>
        <p class="mb-2">@TemporaryPasswordReveal.Notice</p>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OnDismiss">Cerrar aviso</button>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public TemporaryPasswordReveal Reveal { get; set; } = default!;

    [Parameter]
    public EventCallback OnDismiss { get; set; }
}
