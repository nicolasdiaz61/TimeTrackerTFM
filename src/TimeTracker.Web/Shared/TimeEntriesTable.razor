@using System.Globalization
@using TimeTracker.Web.Formatting
@using TimeTracker.Web.TimeEntries

@if (List.Items.Count == 0)
{
    <p>No hay fichajes registrados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Tipo</th>
                    <th>Entrada</th>
                    <th>Salida</th>
                    <th>Minutos</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in List.Items)
                {
                    <tr>
                        <td>@TimeEntryPresentation.TypeLabel(entry.Type)</td>
                        <td>@FormatUtc(entry.ClockInAt)</td>
                        <td>@(entry.ClockOutAt is { } clockOut ? FormatUtc(clockOut) : "en curso")</td>
                        <td>@(entry.DurationMinutes?.ToString(CultureInfo.InvariantCulture))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ul class="list-unstyled totals">
    <li>Total trabajado: <strong>@WorkedTimeFormatter.FormatTotal(List.TotalWorkedMinutes)</strong></li>
    <li>Total en pausas: <strong>@WorkedTimeFormatter.FormatTotal(List.TotalBreakMinutes)</strong></li>
    <li>Total en comidas: <strong>@WorkedTimeFormatter.FormatTotal(List.TotalMealBreakMinutes)</strong></li>
</ul>

@code {
    [Parameter, EditorRequired]
    public TimeEntryListDto List { get; set; } = default!;

    private static string FormatUtc(DateTimeOffset value)
        => value.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture);
}
