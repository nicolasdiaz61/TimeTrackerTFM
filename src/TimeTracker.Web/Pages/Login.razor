@page "/login"
@inject ILoginApi Api
@inject ISessionSignIn Session
@inject JwtAuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject SessionNotice Notice

<PageTitle>Iniciar sesión - TimeTracker</PageTitle>

<div class="auth-card">
<div class="auth-brand"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" /><path d="M8 4.5V8l2.5 1.5" /></svg>TimeTracker</div>
<p class="auth-tagline">Control de tiempos y ausencias para su empresa.</p>
<h1>Iniciar sesión</h1>

@if (sessionExpired)
{
    <div class="alert alert-warning" role="status">Su sesión ha caducado. Inicie sesión de nuevo.</div>
}

<EditForm Model="form" OnSubmit="SubmitAsync" FormName="login">
    <div class="mb-3">
        <label for="email" class="form-label">Correo electrónico</label>
        <InputText id="email" class="form-control" type="email" autocomplete="username" @bind-Value="form.Email" />
    </div>
    <div class="mb-3">
        <label for="password" class="form-label">Contraseña</label>
        <InputText id="password" class="form-control" type="password" autocomplete="current-password" @bind-Value="form.Password" />
    </div>

    @if (form.ErrorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@form.ErrorMessage</div>
    }

    <button type="submit" class="btn btn-primary" disabled="@form.IsBusy">Entrar</button>
</EditForm>
</div>

@code {
    private LoginForm form = default!;
    private bool sessionExpired;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrlParameter { get; set; }

    protected override void OnInitialized() => form = new LoginForm(Api, Session);

    protected override async Task OnInitializedAsync()
    {
        // Se evalúa antes el estado para que un token caducado guardado se detecte (y avise) en esta misma visita.
        await Authentication.GetAuthenticationStateAsync();
        sessionExpired = Notice.Consume();
    }

    protected override void OnParametersSet() => form.ReturnUrlParameter = ReturnUrlParameter;

    private async Task SubmitAsync()
    {
        sessionExpired = false;
        await form.SubmitAsync();
        if (form.NavigateTo is { } target)
        {
            Navigation.NavigateTo(target);
        }
    }
}
