@page "/asistente"
@attribute [Authorize]
@using System.Runtime.CompilerServices
@using TimeTracker.Web.Assistant
@inject AssistantApiClient Api
@inject ChatViewport Viewport

<PageTitle>Asistente - TimeTracker</PageTitle>

<section class="assistant-page" aria-labelledby="assistant-title">
    <header class="assistant-header">
        <div>
            <h1 id="assistant-title">Asistente</h1>
            <p class="text-muted mb-0">Pregunte en lenguaje natural por sus fichajes. La conversación solo se conserva mientras esta página esté abierta.</p>
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="NewConversation" disabled="@(conversation.Turns.Count == 0 || conversation.IsBusy)">Nueva conversación</button>
    </header>

    @if (conversation.Notice is not null)
    {
        <div class="alert alert-warning mb-2" role="alert" data-testid="assistant-notice">@conversation.Notice</div>
    }

    <div class="assistant-messages" role="log" aria-live="polite" aria-label="Conversación con el asistente" @ref="messageList">
        @if (conversation.Turns.Count == 0 && !conversation.IsBusy)
        {
            <div class="assistant-welcome" data-testid="assistant-welcome">
                <p class="assistant-welcome-title">Hola, soy su asistente de fichajes.</p>
                <p class="text-muted">Puede preguntarme, por ejemplo:</p>
                <div class="assistant-chips">
                    @foreach (var question in examples)
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm assistant-chip" @onclick="() => SendExampleAsync(question)">@question</button>
                    }
                </div>
            </div>
        }

        @foreach (var turn in conversation.Turns)
        {
            var isUser = turn.Role == TurnRole.User;
            <div class="assistant-turn @(isUser ? "assistant-turn-user" : "assistant-turn-assistant")">
                <span class="assistant-author">@(isUser ? "Usted" : "Asistente")</span>
                @* Texto plano: Blazor escapa el contenido y white-space: pre-wrap conserva los saltos de línea. *@
                @if (isUser)
                {
                    <p class="assistant-text">@turn.Text</p>
                }
                else
                {
                    foreach (var block in BlocksOf(turn))
                    {
                        if (block is TableBlock table)
                        {
                            <div class="assistant-table-wrap" tabindex="0" role="region" aria-label="Tabla del asistente">
                                <table class="assistant-table">
                                    <thead>
                                        <tr>
                                            @foreach (var header in table.Headers)
                                            {
                                                <th scope="col">@header</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in table.Rows)
                                        {
                                            <tr>
                                                @foreach (var cell in row)
                                                {
                                                    <td>@cell</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="assistant-table-actions">
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => DownloadCsvAsync(table)">Descargar CSV</button>
                            </div>
                        }
                        else if (block is ParagraphBlock paragraph)
                        {
                            <p class="assistant-text">@paragraph.Text</p>
                        }
                    }
                }
            </div>
        }

        @if (conversation.IsBusy)
        {
            <div class="assistant-turn assistant-turn-assistant assistant-typing" role="status" aria-busy="true">
                <span class="assistant-author">Asistente</span>
                <p class="assistant-text">
                    <span class="visually-hidden">Pensando…</span>
                    <span aria-hidden="true">pensando<span class="assistant-dots"><span>.</span><span>.</span><span>.</span></span></span>
                </p>
            </div>
        }

        @if (conversation.ErrorMessage is not null)
        {
            <div class="assistant-turn assistant-turn-error" role="alert" data-testid="assistant-error">
                <span class="assistant-author">Error</span>
                <p class="assistant-text">@conversation.ErrorMessage</p>
            </div>
        }
    </div>

    <form @onsubmit="SendAsync" class="assistant-form">
        <label for="assistant-message" class="form-label mb-1">Su pregunta</label>
        <div class="assistant-input-row">
            <textarea id="assistant-message" class="form-control" rows="2" aria-describedby="assistant-hint assistant-counter"
                      @ref="input" @bind="message" @bind:event="oninput"></textarea>
            <button type="submit" class="btn btn-primary" disabled="@(!CanSend)">Enviar</button>
        </div>
        <div class="assistant-input-meta">
            <small id="assistant-hint" class="text-muted">Intro envía · Mayús+Intro nueva línea</small>
            <small id="assistant-counter" class="assistant-counter @CounterCss" aria-live="off">@AssistantConversation.MessageLength(message) / @AssistantConversation.MaxMessageLength</small>
        </div>
    </form>
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private readonly AssistantConversation conversation = new();
    private IReadOnlyList<string> examples = AssistantConversation.ExampleQuestions(isManager: false);
    private ElementReference messageList;
    private ElementReference input;
    private string message = string.Empty;
    private int renderedTurns;
    private bool renderedBusy;
    private string? renderedError;
    private bool focusPending = true;

    private bool CanSend => !conversation.IsBusy && conversation.Validate(message) is null;

    private string CounterCss => AssistantConversation.CounterLevelFor(AssistantConversation.MessageLength(message)) switch
    {
        CounterLevel.Danger => "assistant-counter-danger",
        CounterLevel.Warning => "assistant-counter-warning",
        _ => string.Empty,
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var state = await AuthenticationStateTask;
            examples = AssistantConversation.ExampleQuestions(state.User.IsInRole("Manager"));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Viewport.SendOnEnterAsync(input);
        }

        if (renderedTurns != conversation.Turns.Count || renderedBusy != conversation.IsBusy || renderedError != conversation.ErrorMessage)
        {
            renderedTurns = conversation.Turns.Count;
            renderedBusy = conversation.IsBusy;
            renderedError = conversation.ErrorMessage;
            await Viewport.ScrollToEndAsync(messageList);
        }

        if (focusPending && !conversation.IsBusy)
        {
            focusPending = false;
            await input.FocusAsync();
        }
    }

    // El análisis se guarda por turno para no repetirlo en cada pulsación del campo de texto.
    private readonly ConditionalWeakTable<ConversationTurn, IReadOnlyList<AssistantBlock>> blockCache = new();

    private IReadOnlyList<AssistantBlock> BlocksOf(ConversationTurn turn)
        => blockCache.GetValue(turn, static t => AssistantMessageParser.Parse(t.Text));

    private Task DownloadCsvAsync(TableBlock table)
        => Viewport.DownloadAsync(CsvBuilder.FileName(DateTime.Now), "text/csv;charset=utf-8", CsvBuilder.Build(table.Headers, table.Rows));

    private async Task SendExampleAsync(string question)
    {
        message = question;
        await SendAsync();
    }

    private void NewConversation()
    {
        conversation.Reset();
        message = string.Empty;
        focusPending = true;
    }

    private async Task SendAsync()
    {
        var sent = message;
        var request = conversation.TryBegin(sent);
        if (request is null)
        {
            return;
        }

        message = string.Empty;
        StateHasChanged();

        var result = await Api.AskAsync(request);
        focusPending = true;
        if (result.Error is { } error)
        {
            // El texto del usuario vuelve al campo (si no escribió otra cosa) para no obligar a reescribirlo.
            conversation.Fail(error, result.RetryAfterSeconds);
            if (message.Length == 0)
            {
                message = sent;
            }

            return;
        }

        conversation.Complete(result.Reply ?? string.Empty);
    }
}
