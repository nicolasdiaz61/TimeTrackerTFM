@page "/asistente"
@attribute [Authorize]
@using TimeTracker.Web.Assistant
@inject AssistantApiClient Api

<PageTitle>Asistente - TimeTracker</PageTitle>

<h1>Asistente</h1>

<p class="text-muted">Pregunte en lenguaje natural por sus fichajes. La conversación solo se conserva mientras esta página esté abierta.</p>

@if (conversation.Notice is not null)
{
    <div class="alert alert-warning" role="alert" data-testid="assistant-notice">@conversation.Notice</div>
}

<div class="assistant-conversation" aria-live="polite">
    @foreach (var turn in conversation.Turns)
    {
        <div class="assistant-turn @(turn.Role == TurnRole.User ? "assistant-turn-user" : "assistant-turn-assistant")">
            <span class="assistant-author">@(turn.Role == TurnRole.User ? "Usted" : "Asistente")</span>
            @* Texto plano: Blazor escapa el contenido y white-space: pre-wrap conserva los saltos de línea. *@
            <p class="assistant-text">@turn.Text</p>
        </div>
    }
</div>

@if (conversation.IsBusy)
{
    <p role="status" aria-busy="true"><em>Consultando…</em></p>
}

@if (conversation.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert" data-testid="assistant-error">@conversation.ErrorMessage</div>
}

<form @onsubmit="SendAsync" class="assistant-form">
    <div class="mb-3">
        <label for="assistant-message" class="form-label">Su pregunta</label>
        <textarea id="assistant-message" class="form-control" rows="3" @bind="message" @bind:event="oninput"></textarea>
    </div>
    <button type="submit" class="btn btn-primary" disabled="@conversation.IsBusy">Enviar</button>
</form>

@code {
    private readonly AssistantConversation conversation = new();
    private string message = string.Empty;

    private async Task SendAsync()
    {
        var request = conversation.TryBegin(message);
        if (request is null)
        {
            return;
        }

        var result = await Api.AskAsync(request);
        if (result.Error is { } error)
        {
            // El texto del usuario permanece en el campo para no obligar a reescribirlo.
            conversation.Fail(error, result.RetryAfterSeconds);
            return;
        }

        conversation.Complete(result.Reply ?? string.Empty);
        message = string.Empty;
    }
}
