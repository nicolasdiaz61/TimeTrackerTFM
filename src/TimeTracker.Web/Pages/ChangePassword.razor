@page "/cambiar-contrasena"
@attribute [Authorize]
@using TimeTracker.Web.Account
@inject IPasswordChangeApi Api
@inject ISessionSignIn Session
@inject NavigationManager Navigation

<PageTitle>Cambiar contraseña - TimeTracker</PageTitle>

<h1>Cambiar contraseña</h1>

@if (changePending)
{
    <div class="alert alert-warning" role="status" data-testid="mandatory-change-notice">@ChangePasswordForm.MandatoryChangeNotice</div>
}

@* Las contraseñas solo viven en los campos de esta página y se vacían tras cada respuesta. *@
<EditForm Model="form" OnSubmit="SubmitAsync" FormName="change-password" class="change-password-form">
    <div class="mb-3">
        <label for="current-password" class="form-label">Contraseña actual</label>
        <InputText id="current-password" class="form-control" type="password" autocomplete="current-password" @bind-Value="form.CurrentPassword" />
        <FieldErrors Messages="@(form.ErrorsFor("currentPassword"))" />
    </div>
    <div class="mb-3">
        <label for="new-password" class="form-label">Contraseña nueva</label>
        <InputText id="new-password" class="form-control" type="password" autocomplete="new-password" @bind-Value="form.NewPassword" />
        <div class="form-text">Entre 12 y 128 caracteres y distinta de la actual.</div>
        <FieldErrors Messages="@(form.ErrorsFor("newPassword"))" />
    </div>
    <div class="mb-3">
        <label for="confirm-password" class="form-label">Confirmar contraseña nueva</label>
        <InputText id="confirm-password" class="form-control" type="password" autocomplete="new-password" @bind-Value="form.ConfirmPassword" />
        <FieldErrors Messages="@(form.ErrorsFor("confirmPassword"))" />
    </div>

    @if (form.ErrorMessage is not null)
    {
        <div class="alert alert-danger" role="alert" data-testid="change-password-error">
            @form.ErrorMessage
            @if (form.OtherErrors.Count > 0)
            {
                <ul class="mb-0">
                    @foreach (var message in form.OtherErrors)
                    {
                        <li>@message</li>
                    }
                </ul>
            }
        </div>
    }

    <button type="submit" class="btn btn-primary" disabled="@form.IsBusy">Cambiar contraseña</button>
</EditForm>

@code {
    private ChangePasswordForm form = default!;
    private bool changePending;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrlParameter { get; set; }

    protected override void OnInitialized() => form = new ChangePasswordForm(Api, Session);

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            changePending = SessionClaims.IsPasswordChangePending((await AuthenticationStateTask).User);
        }
    }

    protected override void OnParametersSet() => form.ReturnUrlParameter = ReturnUrlParameter;

    private async Task SubmitAsync()
    {
        await form.SubmitAsync();
        if (form.NavigateTo is { } target)
        {
            Navigation.NavigateTo(target);
        }
    }
}
