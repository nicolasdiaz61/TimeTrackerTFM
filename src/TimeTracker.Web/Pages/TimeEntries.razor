@page "/fichajes"
@attribute [Authorize]
@using System.Net
@using TimeTracker.Web.Formatting
@using TimeTracker.Web.Http
@using TimeTracker.Web.TimeEntries
@inject TimeEntriesApiClient Api

<PageTitle>Fichajes - TimeTracker</PageTitle>

<h1>Fichajes</h1>

@if (list is not null)
{
    <TrackingStatusBadge Status="@list.Status" />

    <div class="d-flex flex-wrap gap-2 mb-3 clock-actions">
        @foreach (var action in TimeEntryPresentation.AvailableActions(list.Status))
        {
            <button type="button" class="btn @ButtonClass(action)" @onclick="() => RunAsync(action)" disabled="@busy">@TimeEntryPresentation.ActionLabel(action)</button>
        }
    </div>
}

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (busy && list is null)
{
    <p><em>Cargando fichajes...</em></p>
}

@if (list is not null)
{
    <TimeEntriesTable List="list" />
}

@code {
    private TimeEntryListDto? list;
    private string? errorMessage;
    private bool busy = true;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        busy = false;
    }

    private async Task RefreshAsync()
    {
        try
        {
            list = await Api.GetAsync();
            errorMessage = null;
        }
        catch (ApiRequestException exception)
        {
            ShowError(exception);
        }
    }

    private static string ButtonClass(ClockAction action) => action switch
    {
        ClockAction.ClockIn => "btn-primary",
        ClockAction.StartBreak => "btn-warning",
        ClockAction.StartMealBreak => "btn-info",
        ClockAction.EndBreak => "btn-success",
        _ => "btn-secondary",
    };

    // La Web no decide si la acción es válida: lo hace el servidor y aquí solo se muestra su respuesta.
    // Tras un 409 se recarga el listado: el estado pudo cambiar desde otra pestaña y los botones deben reflejarlo.
    private async Task RunAsync(ClockAction action)
    {
        busy = true;
        try
        {
            await Api.RunAsync(action);
            await RefreshAsync();
        }
        catch (ApiRequestException exception)
        {
            ShowError(exception);
            if (exception.StatusCode == HttpStatusCode.Conflict)
            {
                var message = errorMessage;
                await RefreshAsync();
                errorMessage = message;
            }
        }
        finally
        {
            busy = false;
        }
    }

    // Un 401 lo gestiona el BearerTokenHandler (cierra la sesión y lleva a /login): no se muestra como error de la pantalla.
    private void ShowError(ApiRequestException exception)
        => errorMessage = exception.StatusCode == HttpStatusCode.Unauthorized ? null : exception.Message;
}
