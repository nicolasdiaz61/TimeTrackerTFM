@page "/fichajes"
@attribute [Authorize]
@using System.Net
@using TimeTracker.Web.Calendar
@using TimeTracker.Web.Http
@using TimeTracker.Web.Time
@using TimeTracker.Web.TimeEntries
@using TimeTracker.Web.Timeline
@using TimeTracker.Web.WorkSchedules
@inject TimeEntriesApiClient Api
@inject IWorkSchedulesApi Schedules
@inject ILocalTimeZone Zone
@inject TimeProvider Clock

<PageTitle>Fichajes - TimeTracker</PageTitle>

<h1>Fichajes</h1>

@* Esta pantalla es de consulta: las acciones de fichaje están en el reproductor del Inicio (ADR 0016). *@
@if (status is not null)
{
    <div class="status-bar">
        <TrackingStatusBadge Status="@status" />
        <a class="btn btn-primary" href="" data-testid="go-home">Ir al Inicio para fichar</a>
    </div>
}

<MonthNavigator Month="month" Current="current" Disabled="loading" MonthChanged="ChangeMonthAsync" />

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (loading)
{
    <p aria-busy="true"><em>Cargando fichajes...</em></p>
}
else if (timeline is not null)
{
    <MonthTimelineView Timeline="timeline" WorkSchedule="schedule" />
}

@code {
    private MonthRef current;
    private MonthRef month;
    private MonthTimeline? timeline;
    private string? status;
    private WorkScheduleDto? schedule;
    private string? errorMessage;
    private bool loading = true;
    private int loadSequence;

    protected override async Task OnInitializedAsync()
    {
        current = MonthRef.Of(Zone.DateOf(Clock.GetUtcNow()));
        month = current;
        // Sin jornada, o si la consulta falla, no se muestra nada de lo previsto.
        schedule = (await Schedules.MineAsync()).Value;
        await LoadAsync();
    }

    private async Task ChangeMonthAsync(MonthRef selected)
    {
        month = selected;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Cada carga lleva un número: una respuesta antigua (cambios rápidos de mes) no pisa a la más reciente.
        var sequence = ++loadSequence;
        loading = true;
        errorMessage = null;
        try
        {
            var (from, to) = month.Window(Zone);
            var list = await Api.GetAsync(from, to);
            if (sequence != loadSequence)
            {
                return;
            }

            timeline = MonthTimelineBuilder.Build(month, list.Items, Zone, Clock.GetUtcNow());
            status = list.Status;
        }
        catch (ApiRequestException exception)
        {
            if (sequence == loadSequence)
            {
                timeline = null;
                // Un 401 lo gestiona el BearerTokenHandler (cierra la sesión y lleva a /login): no se muestra como error.
                errorMessage = exception.StatusCode == HttpStatusCode.Unauthorized ? null : exception.Message;
            }
        }
        finally
        {
            if (sequence == loadSequence)
            {
                loading = false;
            }
        }
    }
}
