@page "/"

<PageTitle>TimeTracker</PageTitle>

<h1>TimeTracker</h1>

<p class="lead">
    Control de tiempos para su empresa: registre la entrada y la salida de su jornada y consulte el tiempo trabajado.
</p>

<AuthorizeView>
    <Authorized>
        <p>Hola, <strong>@context.User.Identity?.Name</strong>. ¿Qué desea hacer?</p>
        <div class="row g-3 home-actions">
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5 card-title">Fichajes</h2>
                        <p class="card-text">Fiche su entrada y su salida y revise el tiempo que lleva trabajado.</p>
                        <a class="btn btn-primary" href="fichajes">Ir a Fichajes</a>
                    </div>
                </div>
            </div>
            <AuthorizeView Roles="Manager" Context="manager">
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="h5 card-title">Equipo</h2>
                            <p class="card-text">Consulte los fichajes de las personas a su cargo.</p>
                            <a class="btn btn-primary" href="equipo">Ir a Equipo</a>
                        </div>
                    </div>
                </div>
            </AuthorizeView>
        </div>
    </Authorized>
    <NotAuthorized>
        <p>Inicie sesión para fichar y consultar sus fichajes.</p>
        <a class="btn btn-primary" href="login">Iniciar sesión</a>
    </NotAuthorized>
</AuthorizeView>
