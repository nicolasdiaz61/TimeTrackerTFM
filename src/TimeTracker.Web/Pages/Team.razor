@page "/equipo"
@attribute [Authorize(Roles = "Manager")]
@using System.Net
@using TimeTracker.Web.Calendar
@using TimeTracker.Web.Http
@using TimeTracker.Web.Team
@using TimeTracker.Web.Time
@using TimeTracker.Web.Timeline
@inject TeamApiClient Api
@inject ILocalTimeZone Zone
@inject TimeProvider Clock

<PageTitle>Equipo - TimeTracker</PageTitle>

<h1>Equipo</h1>

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (loadingMembers)
{
    <p><em>Cargando equipo...</em></p>
}
else if (members is { Count: 0 })
{
    <p>No tiene personas a su cargo.</p>
}
else if (members is not null)
{
    <div class="mb-3 member-picker">
        <label for="member" class="form-label">Persona</label>
        <select id="member" class="form-select" @onchange="OnMemberChangedAsync">
            <option value="">Seleccione una persona</option>
            @foreach (var member in members)
            {
                <option value="@member.Id" selected="@(member.Id == selectedId)">@member.DisplayName</option>
            }
        </select>
    </div>

    @if (selectedId is not null)
    {
        <MonthNavigator Month="month" Current="current" Disabled="loadingEntries" MonthChanged="ChangeMonthAsync" />

        @if (loadingEntries)
        {
            <p aria-busy="true"><em>Cargando fichajes...</em></p>
        }
        else if (timeline is not null)
        {
            <TrackingStatusBadge Status="@status" />
            <MonthTimelineView Timeline="timeline" />
        }
    }
}

@code {
    private IReadOnlyList<TeamMemberDto>? members;
    private MonthTimeline? timeline;
    private Guid? selectedId;
    private MonthRef current;
    private MonthRef month;
    private string status = "Idle";
    private string? errorMessage;
    private bool loadingMembers = true;
    private bool loadingEntries;
    private int loadSequence;

    protected override async Task OnInitializedAsync()
    {
        current = MonthRef.Of(Zone.DateOf(Clock.GetUtcNow()));
        month = current;
        try
        {
            members = (await Api.GetMembersAsync()).Items;
        }
        catch (ApiRequestException exception)
        {
            errorMessage = MessageFor(exception, forMember: false);
        }
        finally
        {
            loadingMembers = false;
        }
    }

    // Al cambiar de miembro se conserva el mes mostrado.
    private async Task OnMemberChangedAsync(ChangeEventArgs args)
    {
        selectedId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
        await LoadAsync();
    }

    // Al cambiar de mes se conserva el miembro elegido.
    private async Task ChangeMonthAsync(MonthRef selected)
    {
        month = selected;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorMessage = null;
        timeline = null;
        // Cada carga lleva un número: si cambia el miembro o el mes mientras se carga, se descarta la respuesta antigua.
        var sequence = ++loadSequence;
        if (selectedId is not { } memberId)
        {
            loadingEntries = false;
            return;
        }

        loadingEntries = true;
        try
        {
            var (from, to) = month.Window(Zone);
            var list = await Api.GetTimeEntriesAsync(memberId, from, to);
            if (sequence == loadSequence)
            {
                timeline = MonthTimelineBuilder.Build(month, list.Items, Zone, Clock.GetUtcNow());
                status = list.Status;
            }
        }
        catch (ApiRequestException exception)
        {
            if (sequence == loadSequence)
            {
                errorMessage = MessageFor(exception, forMember: true);
            }
        }
        finally
        {
            if (sequence == loadSequence)
            {
                loadingEntries = false;
            }
        }
    }

    // Un 401 lo gestiona el BearerTokenHandler (sesión cerrada y redirección): aquí no se muestra.
    private static string? MessageFor(ApiRequestException exception, bool forMember)
        => exception.StatusCode switch
        {
            HttpStatusCode.Unauthorized => null,
            HttpStatusCode.NotFound when forMember => "Esa persona ya no forma parte de su equipo.",
            HttpStatusCode.Forbidden => "No tiene permiso para ver este equipo.",
            _ => exception.Message,
        };
}
