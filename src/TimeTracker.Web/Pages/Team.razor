@page "/equipo"
@attribute [Authorize(Roles = "Manager")]
@using System.Net
@using TimeTracker.Web.Calendar
@using TimeTracker.Web.Http
@using TimeTracker.Web.Tabs
@using TimeTracker.Web.Team
@using TimeTracker.Web.Time
@using TimeTracker.Web.Timeline
@using TimeTracker.Web.WorkSchedules
@inject TeamApiClient Api
@inject IEmployeesApi Employees
@inject IWorkSchedulesApi Schedules
@inject ILocalTimeZone Zone
@inject TimeProvider Clock
@inject NavigationManager Navigation

<PageTitle>Equipo - TimeTracker</PageTitle>

<header class="page-header">
    <div>
        <h1>Equipo</h1>
        <p class="page-subtitle">Las personas a su cargo y sus fichajes mes a mes.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="equipo/alta">Alta de personas</a>
    </div>
</header>

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (loadingMembers)
{
    <p class="loading-note" aria-busy="true"><em>Cargando equipo...</em></p>
}
else if (members is { Count: 0 })
{
    <p class="empty-state">No tiene personas a su cargo.</p>
}
else if (members is not null)
{
    <TabList Tabs="Tabs" Selected="activeTab" Label="Secciones del equipo" SelectedChanged="SelectTab" />

    @if (activeTab == PeopleTab)
    {
        <section class="card team-people tt-tabpanel" role="tabpanel" id="panel-personas" aria-labelledby="tab-personas" tabindex="0">
            <div class="card-header"><h2 id="team-people-title">Personas a su cargo</h2></div>
            @* La lista no indica quién tiene el cambio pendiente: la acción se ofrece a todas y la API responde si la persona ya cambió su contraseña. *@
            <div class="table-wrap">
                <table class="table align-middle mb-0" data-testid="team-people-table">
                    <caption class="visually-hidden">Personas a su cargo</caption>
                    <thead>
                        <tr>
                            <th scope="col">Persona</th>
                            <th scope="col">Jornada</th>
                            <th scope="col"><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in members)
                        {
                            var current = member;
                            <tr>
                                <th scope="row" class="member-name">@member.DisplayName</th>
                                <td>@(WorkSchedulePresentation.Resolve(schedules, member.WorkScheduleId)?.Name ?? "Sin jornada")</td>
                                <td>
                                    <div class="row-actions">
                                        <button type="button" class="btn btn-sm btn-outline-primary" aria-label="@($"Ver fichajes de {member.DisplayName}")" @onclick="() => ViewEntriesAsync(current.Id)">Ver fichajes</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="@($"Regenerar contraseña temporal de {member.DisplayName}")" disabled="@regeneration.IsBusy"
                                                @onclick="() => regeneration.Request(current.Id, current.DisplayName)">Regenerar contraseña temporal</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @if (regeneration.ConfirmationPending)
        {
            <div class="alert alert-danger mt-3" role="alertdialog" aria-labelledby="regenerate-title" data-testid="regenerate-confirmation">
                <p id="regenerate-title" class="mb-2"><strong>¿Regenerar la contraseña temporal de @regeneration.PendingName?</strong></p>
                <p>La contraseña actual dejará de valer y se mostrará una nueva una sola vez. Solo se puede regenerar antes de que la persona cambie su contraseña.</p>
                <button type="button" class="btn btn-danger" @onclick="ConfirmRegenerationAsync" disabled="@regeneration.IsBusy">Sí, regenerar</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="regeneration.Cancel">Cancelar</button>
            </div>
        }

        @if (regeneration.ErrorMessage is not null)
        {
            <div class="alert alert-danger mt-3" role="alert" data-testid="regenerate-error">@regeneration.ErrorMessage</div>
        }

        <TemporaryPasswordNotice Reveal="regeneration.Reveal" OnDismiss="@(() => regeneration.Reveal.Dismiss())" />
    }
    else
    {
        <section class="card tt-tabpanel" role="tabpanel" id="panel-fichajes" aria-labelledby="tab-fichajes" tabindex="0">
            <div class="card-header"><h2>Fichajes</h2></div>
            <div class="card-body">
                <div class="mb-3 member-picker">
                    <label for="member" class="form-label">Persona</label>
                    <select id="member" class="form-select" @onchange="OnMemberChangedAsync">
                        <option value="">Seleccione una persona</option>
                        @foreach (var member in members)
                        {
                            <option value="@member.Id" selected="@(member.Id == selectedId)">@member.DisplayName</option>
                        }
                    </select>
                </div>

                @if (selectedId is not null)
                {
                    <MonthNavigator Month="month" Current="current" Disabled="loadingEntries" MonthChanged="ChangeMonthAsync" />

                    @if (loadingEntries)
                    {
                        <p class="loading-note" aria-busy="true"><em>Cargando fichajes...</em></p>
                    }
                    else if (timeline is not null)
                    {
                        <TrackingStatusBadge Status="@status" />
                        <MonthTimelineView Timeline="timeline" WorkSchedule="SelectedSchedule" />
                    }
                }
                else
                {
                    <p class="empty-state mb-0">Elija una persona para ver sus fichajes.</p>
                }
            </div>
        </section>
    }
}

@code {
    private const string PeopleTab = "personas";
    private const string EntriesTab = "fichajes";

    private static readonly IReadOnlyList<TabList.TabItem> Tabs =
    [
        new(PeopleTab, "Personas a cargo"),
        new(EntriesTab, "Fichajes"),
    ];

    private static readonly string[] TabKeys = [PeopleTab, EntriesTab];

    private string activeTab = PeopleTab;
    private IReadOnlyList<TeamMemberDto>? members;
    private IReadOnlyList<WorkScheduleDto> schedules = [];

    [SupplyParameterFromQuery(Name = TabSelection.QueryParameter)]
    public string? TabParameter { get; set; }

    private WorkScheduleDto? SelectedSchedule
        => WorkSchedulePresentation.Resolve(schedules, members?.FirstOrDefault(member => member.Id == selectedId)?.WorkScheduleId);
    private MonthTimeline? timeline;
    private Guid? selectedId;
    private MonthRef current;
    private MonthRef month;
    private string status = "Idle";
    private string? errorMessage;
    private bool loadingMembers = true;
    private bool loadingEntries;
    private int loadSequence;
    private TeamMemberTemporaryPassword regeneration = default!;

    protected override void OnInitialized() => regeneration = new TeamMemberTemporaryPassword(Employees);

    protected override void OnParametersSet() => activeTab = TabSelection.Resolve(TabParameter, TabKeys);

    protected override async Task OnInitializedAsync()
    {
        current = MonthRef.Of(Zone.DateOf(Clock.GetUtcNow()));
        month = current;
        try
        {
            members = (await Api.GetMembersAsync()).Items;
            schedules = (await Schedules.ListAsync()).Value?.Items ?? [];
        }
        catch (ApiRequestException exception)
        {
            errorMessage = MessageFor(exception, forMember: false);
        }
        finally
        {
            loadingMembers = false;
        }
    }

    // La pestaña vive en la URL (?tab=): sobrevive a recargar y se puede enlazar; sin apilar historial por cada cambio.
    private void SelectTab(string key)
        => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter(TabSelection.QueryParameter, key), replace: true);

    // «Ver fichajes»: elige a la persona, pasa a la pestaña de fichajes y carga el mes mostrado.
    private async Task ViewEntriesAsync(Guid memberId)
    {
        selectedId = memberId;
        SelectTab(EntriesTab);
        await LoadAsync();
    }

    private Task ConfirmRegenerationAsync() => regeneration.ConfirmAsync();

    // Al cambiar de miembro se conserva el mes mostrado.
    private async Task OnMemberChangedAsync(ChangeEventArgs args)
    {
        selectedId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
        await LoadAsync();
    }

    // Al cambiar de mes se conserva el miembro elegido.
    private async Task ChangeMonthAsync(MonthRef selected)
    {
        month = selected;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorMessage = null;
        timeline = null;
        // Cada carga lleva un número: si cambia el miembro o el mes mientras se carga, se descarta la respuesta antigua.
        var sequence = ++loadSequence;
        if (selectedId is not { } memberId)
        {
            loadingEntries = false;
            return;
        }

        loadingEntries = true;
        try
        {
            var (from, to) = month.Window(Zone);
            var list = await Api.GetTimeEntriesAsync(memberId, from, to);
            if (sequence == loadSequence)
            {
                timeline = MonthTimelineBuilder.Build(month, list.Items, Zone, Clock.GetUtcNow());
                status = list.Status;
            }
        }
        catch (ApiRequestException exception)
        {
            if (sequence == loadSequence)
            {
                errorMessage = MessageFor(exception, forMember: true);
            }
        }
        finally
        {
            if (sequence == loadSequence)
            {
                loadingEntries = false;
            }
        }
    }

    // Un 401 lo gestiona el BearerTokenHandler (sesión cerrada y redirección): aquí no se muestra.
    private static string? MessageFor(ApiRequestException exception, bool forMember)
        => exception.StatusCode switch
        {
            HttpStatusCode.Unauthorized => null,
            HttpStatusCode.NotFound when forMember => "Esa persona ya no forma parte de su equipo.",
            HttpStatusCode.Forbidden => "No tiene permiso para ver este equipo.",
            _ => exception.Message,
        };
}
