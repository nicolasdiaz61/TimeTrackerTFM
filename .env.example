# Claves de entorno de TimeTracker. Copie este archivo a `.env` (no se versiona) y complételo.
# Nunca escriba aquí valores reales: este archivo solo documenta las claves.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- API ---
# Origen permitido por CORS (la Web en local): http://localhost:5172
Cors__AllowedOrigins__0=

# Cadena de conexión cuando se ejecuta la API fuera de compose (compose la construye solo). Sin contraseña real aquí.
ConnectionStrings__Default=

# Aplicar las migraciones al arrancar (compose lo activa por su cuenta).
Database__ApplyMigrationsOnStartup=false

# Clave de firma de los tokens (mínimo 32 bytes). Genérela con PowerShell 7 (`pwsh`; falla en Windows PowerShell 5.1):
#   pwsh -NoProfile -Command "[Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))"
Jwt__SigningKey=

# --- Usuarios de demostración ---
# Siembra de cuatro usuarios inventados al arrancar. Actívela solo en local; no en un despliegue real.
Seed__DemoUsers=false
# Contraseña de los usuarios de demostración: solo en local, de al menos 12 caracteres. Su valor de demostración
# se documenta únicamente en el README; para usar la siembra, escriba en su `.env` la contraseña que figura allí.
Seed__DemoPassword=

# --- Registro de compañías (cerrado por defecto) ---
# POST /api/auth/register-company solo existe con Registration__Enabled=true. Está cerrado por defecto y se abre únicamente cuando el
# aislamiento entre compañías está probado y desplegado; copiar este archivo no lo abre. No puede combinarse con Seed__DemoUsers=true
# (la siembra crea usuarios con una contraseña pública): la API no arranca con las dos activas, y en Production tampoco mientras
# queden usuarios de demostración. En Production exige además ForwardedHeaders__Enabled=true con ForwardedHeaders__Hops >= 1.
Registration__Enabled=false
# Orden de apertura, rotación de códigos y reversión: docs/runbook-railway.md.
# Códigos de invitación del registro, separados por comas (cada uno de 16 a 128 caracteres). Son secretos: se definen
# únicamente en el entorno del despliegue (Railway), nunca en este archivo ni en el repositorio. Para rotarlos se sustituye la lista completa.
# Registration__InviteCodes=
# Tope global de altas por hora entre todas las IP, de 1 a 1000 (30 por defecto). Limita el daño de un código de invitación filtrado;
# solo cuentan las compañías creadas. Aparte, el límite por IP (5 por hora) agrupa IPv6 por prefijo /64.
# Registration__GlobalHourlyLimit=30
# Máximo de personas (Employees y Managers) por compañía, de 1 a 1000. Los topes por compañía se fijan por entorno: no los edita un Manager.
# Company__MaxEmployees=50

# --- Puerto (opcional) ---
# La imagen ya escucha en 8080. Descomente solo para cambiarlo; un valor vacío anularía el de la imagen.
# ASPNETCORE_HTTP_PORTS=8080

# --- Asistente de IA (deshabilitado por defecto) ---
# Sin Ai__Provider el asistente queda deshabilitado: la API arranca igual y POST /api/asistente responde 503.
# Valores admitidos de Ai__Provider: Anthropic, OpenAI, Gemini o Groq (nube) u Ollama (local); cualquier otro valor impide arrancar.
Ai__Provider=
# Ai__ApiKey es un SECRETO (con Anthropic, OpenAI, Gemini y Groq; Ollama no la usa): nunca se escribe en este archivo; defínala en su entorno local
# o como secreto de la plataforma (en Railway: `railway variables set Ai__ApiKey --stdin -s api`).
Ai__ApiKey=
# Nombre del modelo (obligatorio con proveedor); es configuración, no código.
# Ai__Model=
# Servidor de Ollama (obligatorio con Ollama). Desde Docker Compose, el del anfitrión:
# Ai__Endpoint=http://host.docker.internal:11434/
# Límites por usuario y petición (valores por defecto): tokens de salida, iteraciones de herramientas, segundos,
# peticiones por minuto y peticiones por día.
# Ai__MaxOutputTokens=800
# Ai__MaxToolIterations=5
# Ai__TimeoutSeconds=25
# Ai__RequestsPerMinute=5
# Ai__DailyRequestsPerUser=50
# Topes por compañía (valores por defecto): peticiones por minuto de toda la compañía (1 a 600), peticiones por día natural de
# Europe/Madrid (1 a 100000), compañías con proveedor cargado a la vez en memoria (1 a 1000) y minutos de inactividad tras los que se
# descarga la configuración de una compañía (1 a 1440). Las fija solo el entorno: no las edita un Manager, ni desde la Web ni por la API.
# Un valor fuera de rango o no numérico impide arrancar.
# Ai__RequestsPerMinutePerCompany=30
# Ai__DailyRequestsPerCompany=500
# Ai__MaxLoadedCompanies=100
# Ai__RuntimeIdleMinutes=60
# Esfuerzo de razonamiento del modelo (opcional; admitido solo por algunos proveedores y modelos).
# Ai__Effort=
# Proveedores que un Manager puede elegir desde la Web (ADR 0018), separados por comas: Anthropic, OpenAI, Gemini, Groq, Ollama.
# Sin definir esta variable, solo está permitido el proveedor del entorno. No distingue mayúsculas y admite
# espacios tras las comas (por ejemplo, Anthropic, OpenAI, Ollama). Un nombre desconocido, None o GitHubModels impide el arranque.
# Ai__AllowedProviders=
# Claves maestras para cifrar con AES-256-GCM la clave de IA que guarda cada Manager. Son SECRETOS: nunca se escriben
# aquí; defínalas en su entorno local o como secreto de la plataforma. En producción la clave maestra vive solo en Railway.
# El sufijo es la versión de la clave (1, 2, ...).
# Cada clave son 32 bytes aleatorios en Base64; por ejemplo, con PowerShell 7 (`pwsh`):
#   pwsh -NoProfile -Command "[Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))"
# Ai__MasterKeys__1=
# Versión de la clave maestra con la que se cifra lo nuevo; las anteriores siguen sirviendo para descifrar.
# Ai__ActiveMasterKeyVersion=1
# Cada cuántos segundos la API relee la configuración guardada por el Manager.
# Ai__SettingsPollSeconds=
